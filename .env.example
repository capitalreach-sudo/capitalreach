# CapitalReach — every environment variable the app reads.
#
# Copy to .env.local (gitignored) and fill in. Nothing here is a real value and
# nothing here should ever be committed with one.
#
# Only the REQUIRED block is needed to boot. Everything else degrades on its
# own: no Stripe means no billing, no Resend means no email, no OpenAI means
# the AI routes return 503. See lib/env.ts — that is the canonical list, and
# `npm run check:env` reports what is actually set.
#
# Values containing REPLACE_ME, placeholder, your-, xxx or changeme are treated
# as unset by lib/env.ts, so a half-filled file fails closed rather than
# half-working.


# ── REQUIRED ─────────────────────────────────────────────────────────────────
# assertCoreEnv() throws without these two.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely — never expose to the client, never
# prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ── App identity ─────────────────────────────────────────────────────────────

# Used to build links in emails. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Drives every support@/noreply@ address via lib/brand.ts. Deliberately has no
# default: capitalreach.com is not ours and has live MX records, so a fallback
# would send real user mail to a stranger's mailbox.
NEXT_PUBLIC_BRAND_DOMAIN=


# ── Email (Resend) ───────────────────────────────────────────────────────────
# Unset means transactional email is skipped with a console warning, not an
# error.
#
# NOTE: this does NOT cover signup confirmation emails. Those are sent by
# Supabase Auth, not by this app, and are capped by the Supabase project's own
# rate limit. To route those through Resend as well, set the SMTP credentials
# in the Supabase dashboard under Authentication -> Emails -> SMTP Settings.

RESEND_API_KEY=

# Must be on a domain verified in Resend or every send is rejected.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Where the contact form delivers. No default on purpose — the route refuses
# to send when this is unset rather than guessing an address.
CONTACT_INBOX_EMAIL=


# ── Billing (Stripe) ─────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WARNING: two naming schemes exist for the same four prices. lib/plans.ts
# declares the _MONTHLY names, while the checkout routes in
# app/api/checkout/* read the _PRICE_ID names — so setting only one scheme
# leaves checkout broken. Until they are unified, set BOTH columns to the same
# price IDs.
STRIPE_PRICE_FOUNDER_STARTER_MONTHLY=
STRIPE_STARTUP_STARTER_PRICE_ID=

STRIPE_PRICE_FOUNDER_GROWTH_MONTHLY=
STRIPE_STARTUP_GROWTH_PRICE_ID=

STRIPE_PRICE_INVESTOR_ANGEL_MONTHLY=
STRIPE_INVESTOR_ANGEL_PRICE_ID=

STRIPE_PRICE_INVESTOR_PRO_MONTHLY=
STRIPE_INVESTOR_PRO_PRICE_ID=

STRIPE_INVESTOR_INSTITUTIONAL_PRICE_ID=


# ── AI (OpenAI) ──────────────────────────────────────────────────────────────
# Unset means /api/ai/* returns 503. These routes cost real money per call and
# are auth-gated and rate-limited.

OPENAI_API_KEY=


# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Unset falls back to in-memory limiting, which is per-instance and therefore
# ineffective across serverless invocations. Set both for deployed use.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Contracts (DocuSign) ─────────────────────────────────────────────────────

DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi


# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret the cron routes require before running. Without it the
# endpoints are unauthenticated — set a long random value.

CRON_SECRET=

# Optional: POST target for admin notifications.
ADMIN_NOTIFICATION_WEBHOOK=

# Optional: Trigger.dev background jobs.
TRIGGER_SECRET_KEY=
